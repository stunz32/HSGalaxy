<Window x:Class="HSGalaxy.App.Settings.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotkey Settings" Height="220" Width="420" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Theme:" VerticalAlignment="Center"/>
        <TextBox x:Name="TxtTheme" Grid.Column="1" Margin="8,0,0,0" Height="26" VerticalContentAlignment="Center"
                 PreviewKeyDown="Txt_PreviewKeyDown"/>
        <Button Content="Reset" Grid.Column="2" Margin="8,0,0,0" Click="BtnResetTheme_Click"/>

        <TextBlock Grid.Row="1" Text="Capture:" VerticalAlignment="Center"/>
        <TextBox x:Name="TxtCapture" Grid.Row="1" Grid.Column="1" Margin="8,4,0,0" Height="26" VerticalContentAlignment="Center"
                 PreviewKeyDown="Txt_PreviewKeyDown"/>
        <Button Grid.Row="1" Grid.Column="2" Content="Reset" Margin="8,4,0,0" Click="BtnResetCapture_Click"/>

        <TextBlock Grid.Row="2" Text="Wizard:" VerticalAlignment="Center"/>
        <TextBox x:Name="TxtWizard" Grid.Row="2" Grid.Column="1" Margin="8,4,0,0" Height="26" VerticalContentAlignment="Center"
                 PreviewKeyDown="Txt_PreviewKeyDown"/>
        <Button Grid.Row="2" Grid.Column="2" Content="Reset" Margin="8,4,0,0" Click="BtnResetWizard_Click"/>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button Content="Save" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>

