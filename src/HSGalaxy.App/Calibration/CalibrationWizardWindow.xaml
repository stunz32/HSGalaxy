<Window x:Class="HSGalaxy.App.Calibration.CalibrationWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calibration Wizard" Height="520" Width="720" Topmost="True"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Step 1: Choose target window; Step 2: Draw ROIs; Step 3: Save/Load."/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Step 1: Window picker -->
            <GroupBox Header="Target Window" Margin="0,0,8,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBox x:Name="TxtFilter" Width="220" Margin="0,0,6,0" TextChanged="TxtFilter_TextChanged"/>
                        <Button Content="Refresh" Click="BtnRefresh_Click"/>
                        <Button Content="Select" Margin="6,0,0,0" Click="BtnSelectWindow_Click"/>
                    </StackPanel>
                    <ListBox x:Name="LstWindows" SelectionChanged="LstWindows_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" ToolTip="{Binding Class}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>

            <!-- Step 2/3: Profile + actions -->
            <GroupBox Grid.Column="1" Header="Profile &amp; Actions">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Profile:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtProfile" Width="200" Margin="6,0,0,0" Text="Default"/>
                        <Button Content="Load" Margin="6,0,0,0" Click="BtnLoad_Click"/>
                        <Button Content="Reattach" Margin="6,0,0,0" Click="BtnReattach_Click"/>
                        <Button Content="Save" Margin="6,0,0,0" Click="BtnSave_Click"/>
                        <Button Content="Export Profile…" Margin="6,0,0,0" Click="BtnExport_Click"/>
                        <Button Content="Import Profile…" Margin="6,0,0,0" Click="BtnImport_Click"/>
                        <Button Content="Export All…" Margin="6,0,0,0" Click="BtnExportAll_Click"/>
                        <Button Content="Clear ROIs" Margin="6,0,0,0" Click="BtnClear_Click"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,6">
Press and drag on the overlay to create a ROI. Drag inside a ROI to move it. Press Delete to remove the last ROI. The overlay is sized and positioned to the target window with Per-Monitor-V2 DPI.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open Overlay" Click="BtnOpenOverlay_Click"/>
                        <Button Content="Close Overlay" Margin="6,0,0,0" Click="BtnCloseOverlay_Click"/>
                        <Button Content="Capture Proof PNG" Margin="6,0,0,0" Click="BtnCaptureProof_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtStatus" Margin="0,8,0,0" Foreground="#FFFF0A70"/>

                    <GroupBox Header="ROIs (id / position / size)" Margin="0,10,0,0">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button x:Name="BtnDeleteRoi" Content="Delete" Click="BtnDeleteRoi_Click"/>
                            </StackPanel>
                            <ListView x:Name="LstRois" Height="200" SelectionChanged="LstRois_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Id" Width="140">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" LostFocus="TxtRoiId_LostFocus" KeyDown="TxtRoiId_KeyDown"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Pos" Width="110" DisplayMemberBinding="{Binding Pos}"/>
                                        <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding Size}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Header="Test OCR" Margin="0,10,0,0">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button Content="Run OCR" Click="BtnRunOcr_Click"/>
                                <Button Content="Copy All" Margin="6,0,0,0" Click="BtnCopyAll_Click"/>
                                <Button Content="Copy Text Only" Margin="6,0,0,0" Click="BtnCopyTextOnly_Click"/>
                                <Button Content="Save Results" Margin="6,0,0,0" Click="BtnSaveResults_Click"/>
                                <TextBlock x:Name="TxtOcrMeta" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtOcrOffline" Margin="12,0,0,0" Foreground="#FFFF0A70" FontWeight="Bold" Visibility="Collapsed" Text="Offline Mode"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Text="Filter ROI:" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtOcrFilterRoi" Width="120" Margin="6,0,12,0" TextChanged="TxtOcrFilter_Changed"/>
                                <TextBlock Text="Min Conf:" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtOcrMinConf" Width="60" Margin="6,0,12,0" TextChanged="TxtOcrFilter_Changed"/>
                                <TextBlock x:Name="TxtOcrCounters" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="LstOcr" Height="200">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="ROI" Width="80" DisplayMemberBinding="{Binding RoiId}"/>
                                        <GridViewColumn Header="Conf" Width="60" DisplayMemberBinding="{Binding Confidence}"/>
                                        <GridViewColumn Header="Text" Width="320" DisplayMemberBinding="{Binding Text}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </GroupBox>
                </StackPanel>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
