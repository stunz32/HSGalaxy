<Window x:Class="HSGalaxy.App.Calibration.CalibrationWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calibration Wizard" Height="520" Width="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Step 1: Choose target window; Step 2: Draw ROIs; Step 3: Save/Load."/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Step 1: Window picker -->
            <GroupBox Header="Target Window" Margin="0,0,8,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBox x:Name="TxtFilter" Width="220" Margin="0,0,6,0" TextChanged="TxtFilter_TextChanged"/>
                        <Button Content="Refresh" Click="BtnRefresh_Click"/>
                        <Button Content="Select" Margin="6,0,0,0" Click="BtnSelectWindow_Click"/>
                    </StackPanel>
                    <ListBox x:Name="LstWindows">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" ToolTip="{Binding Class}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>

            <!-- Step 2/3: Profile + actions -->
            <GroupBox Grid.Column="1" Header="Profile &amp; Actions">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Profile:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtProfile" Width="200" Margin="6,0,0,0" Text="Default"/>
                        <Button Content="Load" Margin="6,0,0,0" Click="BtnLoad_Click"/>
                        <Button Content="Save" Margin="6,0,0,0" Click="BtnSave_Click"/>
                        <Button Content="Clear ROIs" Margin="6,0,0,0" Click="BtnClear_Click"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,6">
Press and drag on the overlay to create a ROI. Drag inside a ROI to move it. Press Delete to remove the last ROI. The overlay is sized and positioned to the target window with Per-Monitor-V2 DPI.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open Overlay" Click="BtnOpenOverlay_Click"/>
                        <Button Content="Close Overlay" Margin="6,0,0,0" Click="BtnCloseOverlay_Click"/>
                        <Button Content="Capture Proof PNG" Margin="6,0,0,0" Click="BtnCaptureProof_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtStatus" Margin="0,8,0,0" Foreground="#FF0A7"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
